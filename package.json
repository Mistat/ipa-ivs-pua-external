{
  "name": "ivs-font-processor",
  "version": "1.0.0",
  "description": "IVS (Ideographic Variation Sequence) character font processing and PUA mapping utilities",
  "main": "src/utils/ivsUtils.js",
  "type": "module",
  "files": [
    "src/utils/",
    "fonts/ipa-ivs-external.ttf",
    "fonts/ipa-ivs-external.woff2",
    "scripts/",
    "README.md"
  ],
  "exports": {
    ".": "./src/utils/ivsUtils.js",
    "./mapping": "./src/utils/ivsCharacterMap.js",
    "./fonts": "./fonts/",
    "./scripts": "./scripts/"
  },
  "bin": {
    "install-ivs-fonts": "./scripts/install-fonts.cjs"
  },
  "scripts": {
    "setup": "fontforge -script scripts/generate.py",
    "test": "echo 'No unit tests yet' && exit 0"
  },
  "keywords": [
    "ivs",
    "ideographic-variation-sequence",
    "pua",
    "private-use-area",
    "font",
    "unicode",
    "japanese",
    "cjk",
    "moji",
    "typography",
    "web-fonts"
  ],
  "author": "Misato Takahashi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mistat/ipa-ivs-pua-external.git"
  },
  "bugs": {
    "url": "https://github.com/Mistat/ipa-ivs-pua-external/issues"
  },
  "homepage": "https://github.com/Mistat/ipa-ivs-pua-external#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {}
}
